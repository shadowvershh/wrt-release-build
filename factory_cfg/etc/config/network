
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004f37410a26a6d4f61af79af1ee347ebd7'
	option ula_prefix 'fdf4:b31c:652::/48'
	option packet_steering '0'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan0'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'dheth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ip6assign '60'
	option gateway '192.168.31.1'
	option ipaddr '192.168.31.100'
	option netmask '255.255.255.0'
	option peerdns '0'

